                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "schedule"
                    ],
                    "properties": {
                      "schedule": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "object",
                          "properties": {
                            "effective_from": {
                              "type": "string"
                            },
                            "effective_until": {
                              "type": "string"
                            },
                            "input": {
                              "type": "number",
                              "minimum": 0
                            },
                            "output": {
                              "type": "number",
                              "minimum": 0
                            }
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          },
          "audio_tokens": {
            "type": "object",
            "properties": {
              "standard": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "input_per_million": {
                        "type": "number",
                        "minimum": 0
                      },
                      "output_per_million": {
                        "type": "number",
                        "minimum": 0
                      }
                    },
                    "not": {
                      "required": [
                        "schedule"
                      ]
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "schedule"
                    ],
                    "properties": {
                      "schedule": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "object",
                          "properties": {
                            "effective_from": {
                              "type": "string"
                            },
                            "effective_until": {
                              "type": "string"
                            },
                            "input_per_million": {
                              "type": "number",
                              "minimum": 0
                            },
                            "output_per_million": {
                              "type": "number",
                              "minimum": 0
                            }
                          }
                        }
                      }
                    }
                  }
                ]
              },
              "batch": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "input_per_million": {
                        "type": "number",
                        "minimum": 0
                      },
                      "output_per_million": {
                        "type": "number",
                        "minimum": 0
                      }
                    },
                    "not": {
                      "required": [
                        "schedule"
                      ]
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "schedule"
                    ],
                    "properties": {
                      "schedule": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "object",
                          "properties": {
                            "effective_from": {
                              "type": "string"
                            },
                            "effective_until": {
                              "type": "string"
                            },
                            "input_per_million": {
                              "type": "number",
                              "minimum": 0
                            },
                            "output_per_million": {
                              "type": "number",
                              "minimum": 0
                            }
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          },
          "embeddings": {
            "type": "object",
            "properties": {
              "standard": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "input_per_million": {
                        "type": "number",
                        "minimum": 0
                      }
                    },
                    "not": {
                      "required": [
