                ]
              },
              "batch": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "input_per_million": {
                        "type": "number",
                        "minimum": 0
                      }
                    },
                    "not": {
                      "required": [
                        "schedule"
                      ]
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "schedule"
                    ],
                    "properties": {
                      "schedule": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "object",
                          "properties": {
                            "effective_from": {
                              "type": "string"
                            },
                            "effective_until": {
                              "type": "string"
                            },
                            "input_per_million": {
                              "type": "number",
                              "minimum": 0
                            }
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "description": "Pricing information for the model"
      },
      "metadata": {
        "type": "object",
        "description": "Additional metadata about the model"
      }
    }
  }
}
